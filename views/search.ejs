<%- include('partials/header', { title: 'Notice search' }) %>
<section class="page-heading compact"><div><p class="eyebrow">STAY INFORMED</p><h1>What's happening?</h1><p class="lead">Search the latest updates around campus.</p></div><span class="page-index">03 / 05</span></section>
<section class="panel"><form class="search-form" method="get" action="/search"><div><label for="q">Search notices</label><input id="q" name="q" value="<%= query %>" maxlength="500" placeholder="Try library, project, or football"></div><button type="submit">Search notices</button></form></section>
<div class="results-summary"><% if (query) { %><p>You searched for: <strong><% if (protectedOutput) { %><%# FIX: escaped HTML text output %><%= query %><% } else { %><%# VULNERABILITY: raw user input becomes HTML %><%- query %><% } %></strong></p><% } else { %><h2>Latest notices</h2><% } %><span><%= results.length %> result<%= results.length === 1 ? '' : 's' %></span></div>
<section class="notice-list"><% results.forEach(n => { %><article class="notice"><span class="pill"><%= n.tag %></span><h3><%= n.title %></h3><p><%= n.text %></p></article><% }) %><% if (!results.length) { %><div class="empty-state"><h3>No matching notices</h3><p>Try another keyword or clear your search to see all notices.</p><a class="text-link" href="/search">View all notices →</a></div><% } %></section>
<%- include('partials/footer') %>
