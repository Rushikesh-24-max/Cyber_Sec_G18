<%- include('partials/header', { title: 'Feedback board' }) %>
<section class="page-heading compact"><div><p class="eyebrow">YOUR VOICE</p><h1>Make campus better.</h1><p class="lead">A small space for ideas, suggestions, and feedback.</p></div><span class="page-index">04 / 05</span></section>
<div class="content-grid"><section class="panel"><h2>Leave a thought</h2><p class="muted">Your message will appear on the board below.</p><form method="post" action="/feedback"><label for="author">Your name</label><input id="author" name="author" maxlength="60" placeholder="Student" autocomplete="off"><label for="body">Your feedback</label><textarea id="body" name="body" rows="5" maxlength="1000" required placeholder="What would you like to share?"></textarea><button type="submit">Post feedback <span aria-hidden="true">→</span></button></form></section><aside class="side-note"><p class="eyebrow">COMMUNITY NOTES</p><h2>Good ideas<br>start here.</h2><p>Messages are saved locally, so they remain on the board when you revisit or restart the portal.</p><p class="fine-print">Use fictional names and dummy messages for this assignment.</p></aside></div>
<div class="section-heading"><h2>The conversation <span class="count"><%= comments.length %></span></h2><form method="post" action="/feedback/clear"><button class="button-subtle" type="submit">Clear demo feedback</button></form></div>
<section class="comment-list"><% comments.forEach(c => { %><article class="comment"><div class="comment-author"><span class="avatar"><%= c.author.charAt(0).toUpperCase() %></span><div><strong><%= c.author %></strong><small><%= c.created_at %> UTC</small></div></div><div class="comment-body"><% if (protectedOutput) { %><%# FIX: encode stored input at the HTML output sink %><%= c.body %><% } else { %><%# VULNERABILITY: stored input rendered as raw HTML %><%- c.body %><% } %></div></article><% }) %><% if (!comments.length) { %><div class="empty-state"><h3>Start the conversation</h3><p>Your first message will appear here.</p></div><% } %></section>
<%- include('partials/footer') %>
